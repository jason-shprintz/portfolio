---
import { projects } from '../../data/projects';
import { LINKS } from '../../constants';
---

<div class="hr"></div>

<section id="work" class="work">
  <div class="header">
    <div>
      <div class="kick" style="margin-bottom: 14px;">03 — Selected work</div>
      <h2 class="heading">Things I have shipped</h2>
    </div>
    <a href={LINKS.toastbyte} target="_blank" rel="noopener" class="kick"
      >Toastbyte Studios ↗</a
    >
  </div>
  <div class="list">
    {
      projects.map((p) => (
        <article class="item">
          <div
            class={`plate img-plate${p.imageVariant ? ` img-plate--${p.imageVariant}` : ''}`}
          >
            <img
              src={p.imgSrc}
              alt={p.name}
              loading="lazy"
              decoding="async"
              {...(!p.imageVariant ? { 'data-lightmat': true } : {})}
              class={`img${p.imageVariant ? ' img--logo' : ''}`}
            />
          </div>
          <div>
            <div class="title-row">
              <h3 class="name">{p.name}</h3>
              <span class="kick">{p.status}</span>
            </div>
            <p class="blurb">{p.description}</p>
            <div class="tech-row">
              {p.tech.map((t) => (
                <span class="tag tag-outline">{t}</span>
              ))}
            </div>
            <a
              href={p.link}
              target="_blank"
              rel="noopener"
              class="btn btn-secondary"
            >
              {p.domain} ↗
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .work {
    padding: 72px 0;
  }

  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .header a {
    text-decoration: none;
  }

  .heading {
    font-size: 40px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .list {
    display: grid;
    gap: 0;
  }

  .item {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 48px;
    align-items: start;
    padding: 44px 0;
    border-top: 1px solid var(--color-divider);
  }

  .img-plate {
    background: var(--color-surface);
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * Logo plates. These images are marks rather than screenshots, so they get
   * contained with breathing room and sit on a plate whose color follows the
   * theme — rather than the data-lightmat treatment, which paints a light
   * backdrop behind a screenshot in dark mode.
   *
   * Each variant declares its own pair; the resolution below is shared.
   */
  .img--logo {
    object-fit: contain;
    padding: 10%;
  }

  .img-plate--gitall {
    --plate-light: #ffffff;
    --plate-dark: #0d1117;
  }

  .img-plate--alleyadmin {
    --plate-light: #fbf7f0;
    --plate-dark: #141210;
  }

  .img-plate--gitall,
  .img-plate--alleyadmin {
    background: var(--plate-light);
  }

  :global(html[data-theme='dark']) .img-plate--gitall,
  :global(html[data-theme='dark']) .img-plate--alleyadmin {
    background: var(--plate-dark);
  }

  /*
   * No-JS fallback. Scoped so an explicit light choice still wins, since the
   * theme is driven by the data attribute rather than the media query.
   */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .img-plate--gitall,
    :global(html:not([data-theme='light'])) .img-plate--alleyadmin {
      background: var(--plate-dark);
    }
  }

  .title-row {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .name {
    font-size: 30px;
    font-weight: 400;
  }

  .blurb {
    margin: 0 0 20px;
    font-size: 17px;
    line-height: 1.7;
    text-align: justify;
    hyphens: auto;
  }

  .tech-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  @media (max-width: 900px) {
    .item {
      grid-template-columns: 1fr;
    }
  }
</style>
