---
import { LINKS } from '../../constants';

const year = new Date().getFullYear();
---

<footer class="footer">
  <span class="num">© {year} Jason Shprintz</span>
  <span class="links">
    <a href={LINKS.github} target="_blank" rel="noopener">GitHub</a>
    <a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a href={LINKS.toastbyte} target="_blank" rel="noopener"
      >Toastbyte Studios</a
    >
  </span>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 80px;
    padding-top: 24px;
    border-top: 1px solid var(--color-divider);
    font-size: 14px;
    color: color-mix(in srgb, var(--color-text) 62%, transparent);
  }

  .links {
    display: flex;
    gap: 22px;
  }

  .links a {
    color: inherit;
  }
</style>
