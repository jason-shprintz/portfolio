---
import ThemeToggle from './ThemeToggle';
---

<header class="header">
  <a href="#top" class="brand">Jason Shprintz</a>
  <details class="nav-shell">
    <summary class="kick nav-toggle" aria-label="Toggle navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </summary>
    <nav class="nav">
      <a href="#about" class="kick nav-link">About</a>
      <a href="#skills" class="kick nav-link">Skills</a>
      <a href="#work" class="kick nav-link">Work</a>
      <a href="#experience" class="kick nav-link">Experience</a>
      <a href="#contact" class="kick nav-link">Contact</a>
      <ThemeToggle client:load />
    </nav>
  </details>
</header>

<style>
  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    padding: 28px 0 20px;
    border-bottom: 1px solid var(--color-divider);
  }

  .brand {
    font-family: var(--font-heading);
    font-size: 19px;
    letter-spacing: 0.02em;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-shell {
    margin-left: auto;
  }

  .nav-toggle {
    display: none;
  }

  .nav-link {
    text-decoration: none;
  }

  @media (max-width: 760px) {
    .header {
      align-items: center;
      gap: 16px;
    }

    .nav-shell {
      width: auto;
    }

    .nav-shell[open] {
      width: 100%;
      flex-basis: 100%;
    }

    .nav-toggle {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      margin-left: auto;
      width: 40px;
      height: 40px;
      border: 1px solid var(--color-divider);
      border-radius: 4px;
      list-style: none;
      cursor: pointer;
    }

    .nav-toggle::-webkit-details-marker {
      display: none;
    }

    .nav-toggle span {
      width: 18px;
      height: 2px;
      background: var(--color-text);
    }

    .nav {
      display: none;
      margin-top: 12px;
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .nav-shell[open] .nav {
      display: flex;
    }
  }
</style>
