---
import { skillGroups } from '../../data/skills';
---

<div class="hr"></div>

<section id="skills" class="cols">
  <div>
    <div class="kick" style="margin-bottom: 14px;">02 — Skills</div>
    <h2 class="heading">Tools of the trade</h2>
  </div>
  <div class="rows">
    {
      skillGroups.map((g) => (
        <div class="row">
          <div class="kick label">{g.label}</div>
          <p class="items">{g.items.join(' · ')}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .cols {
    display: grid;
    grid-template-columns: 1fr 1.9fr;
    gap: 64px;
    padding: 72px 0;
  }

  .heading {
    font-size: 40px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .rows {
    display: grid;
    gap: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 28px;
    padding: 20px 0;
    border-top: 1px solid var(--color-divider);
  }

  .label {
    padding-top: 4px;
  }

  .items {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
