---
import { experience } from "../../data/experience";
---

<div class="hr"></div>

<section id="experience" class="experience">
  <div class="header">
    <div class="kick" style="margin-bottom: 14px;">04 — Experience</div>
    <h2 class="heading">Ten years of shipping</h2>
  </div>
  {
    experience.map((job) => (
      <div class="row">
        <div>
          <div class="company-row">
            <img src={job.imgSrc} alt={job.name} class="logo" />
            <span class="company">{job.name}</span>
          </div>
          <div class="title">{job.title}</div>
          <div class="kick num" style="margin-top: 8px;">{job.time}</div>
        </div>
        <ul class="bullets">
          {job.description.map((d) => (
            <li>{d}</li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .experience {
    padding: 72px 0;
  }

  .header {
    margin-bottom: 48px;
  }

  .heading {
    font-size: 40px;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1.9fr;
    gap: 64px;
    padding: 34px 0;
    border-top: 1px solid var(--color-divider);
  }

  .company-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .logo {
    width: 32px;
    height: 32px;
    object-fit: cover;
    border-radius: var(--radius-sm);
    outline: 1px solid var(--color-divider);
  }

  .company {
    font-family: var(--font-heading);
    font-size: 21px;
  }

  .title {
    font-size: 15px;
    font-style: italic;
    color: color-mix(in srgb, var(--color-text) 72%, transparent);
  }

  .bullets {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .bullets li {
    font-size: 16px;
    line-height: 1.7;
    padding-left: 20px;
    border-left: 1px solid var(--color-accent-300);
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
