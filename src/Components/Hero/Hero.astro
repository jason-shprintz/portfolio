---
import { LINKS } from "../../constants";

const email = LINKS.email.replace("mailto:", "");
---

<section class="hero">
  <div>
    <div class="kick" style="margin-bottom: 22px;">
      Software Developer · Las Vegas, Nevada
    </div>
    <h1 class="name">Jason<br />Shprintz</h1>
    <p class="lede">
      I build production-grade web applications in React and TypeScript,
      with a focus on performance, clarity and the details users feel but
      rarely name.
    </p>
    <div class="actions">
      <a
        href="/assets/documents/Jason_Shprintz_Resume.pdf"
        target="_blank"
        rel="noopener"
        class="btn btn-primary"
      >
        Download résumé
      </a>
      <a href={LINKS.email} class="btn btn-secondary">{email}</a>
    </div>
  </div>
  <div>
    <div class="plate">
      <img
        src="assets/images/headshot_cropped.jpg"
        alt="Jason Shprintz"
        class="headshot"
      />
    </div>
    <div class="social">
      <a href={LINKS.github} target="_blank" rel="noopener" class="kick"
        >GitHub ↗</a
      >
      <a href={LINKS.linkedin} target="_blank" rel="noopener" class="kick"
        >LinkedIn ↗</a
      >
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 64px;
    align-items: end;
    padding: 72px 0 56px;
  }

  .name {
    font-size: 76px;
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 26px;
  }

  .lede {
    font-size: 20px;
    line-height: 1.6;
    max-width: 44ch;
    margin: 0 0 32px;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .headshot {
    display: block;
    width: 100%;
    height: auto;
  }

  .social {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }

  .social a {
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
